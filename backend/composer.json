{
    "name": "digitallibrary/backend",
    "description": "Digital Library Management System - PHP REST API",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "report",
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}
